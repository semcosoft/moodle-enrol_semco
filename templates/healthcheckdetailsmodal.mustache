{{!
    @template enrol_semco/healthcheckdetailsmodal

    SEMCO health check details modal template.

    Context variables required for this template:
    * summary - The health check item summary
    * description - The health check item description
    * statuslabel - The status label
    * statusbadgeclass - The bootstrap badge class for the status
    * statusdescription - The status description
    * findings - The list of findings, each with a 'finding' key
    * hasmultiplefindings - Whether there is more than one finding
    * singlefinding - The one and only finding, if there is exactly one
    * possiblesolution - The possible solution hint

    Example context (json):
    {
        "summary": "Short summary",
        "description": "Long description",
        "statuslabel": "Warning",
        "statusbadgeclass": "badge-warning",
        "statusdescription": "This health check needs your attention.",
        "findings": [ { "finding": "The capability enrol/semco:enrol is not allowed." } ],
        "possiblesolution": "You can click the wand icon."
    }
}}
<div class="enrol_semco-healthcheckdetails-modal">
    {{#summary}}
        <p><strong>{{summary}}</strong></p>
    {{/summary}}
    {{#description}}
        <p>{{description}}</p>
    {{/description}}
    {{#statusdescription}}
        <p><strong>{{#str}}healthcheckcurrentstatus, enrol_semco{{/str}}</strong><br />
        <span class="badge {{statusbadgeclass}}">{{statuslabel}}</span> {{statusdescription}}</p>
    {{/statusdescription}}
    {{! The findings are HTML as they may contain lists, thus they are output unescaped. A list must not be wrapped in
        a paragraph, thus the single finding gets a div. }}
    {{#singlefinding}}
        <p class="mb-0"><strong>{{#str}}healthcheckfinding, enrol_semco{{/str}}</strong></p>
        <div class="mb-3">{{{singlefinding}}}</div>
    {{/singlefinding}}
    {{#hasmultiplefindings}}
        <p class="mb-0"><strong>{{#str}}healthcheckfindings, enrol_semco{{/str}}</strong></p>
        <ul class="enrol_semco-healthcheckdetails-findings">
            {{#findings}}
                <li>{{{finding}}}</li>
            {{/findings}}
        </ul>
    {{/hasmultiplefindings}}
    {{#possiblesolution}}
        <p><strong>{{#str}}healthcheckpossiblesolutions, enrol_semco{{/str}}</strong><br />
        {{possiblesolution}}</p>
    {{/possiblesolution}}
</div>
